<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" styleClass="control-panel" xmlns="http://javafx.com/javafx/26" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="view.graphic.ui.controller.ControlPanel">

    <fx:define>
        <ToggleGroup fx:id="toolGroup" />
    </fx:define>

    <Label styleClass="panel-section-title" text="🎮 Điều Khiển" />
    <VBox spacing="8" styleClass="panel-section">
        <Button fx:id="btnPause" maxWidth="Infinity" onAction="#onPauseClicked" styleClass="btn-primary" text="⏸ Pause" />
        <Button maxWidth="Infinity" onAction="#onResetZoomClicked" styleClass="btn-secondary" text="🔍 Reset Zoom" />
    </VBox>

    <Separator />

    <Label styleClass="panel-section-title" text="⚡ Tốc Độ" />
    <VBox spacing="6" styleClass="panel-section">
        <ChoiceBox fx:id="choiceSpeed" maxWidth="Infinity" onAction="#onSpeedChanged" />
    </VBox>

    <Separator />

    <Label styleClass="panel-section-title" text="🛠 Công Cụ" />
    <VBox spacing="5" styleClass="panel-section">
        <RadioButton fx:id="rbNone" onAction="#onToolNone" selected="true" styleClass="tool-radio" text="🚫 Không chọn" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbBush" onAction="#onToolBush" styleClass="tool-radio" text="🟩 Gieo bụi" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbRabbit" onAction="#onToolRabbit" styleClass="tool-radio" text="⚪ Thêm Thỏ" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbWolf" onAction="#onToolWolf" styleClass="tool-radio" text="🔘 Thêm Sói" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbTiger" onAction="#onToolTiger" styleClass="tool-radio" text="🟠 Thêm Hổ" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbElephant" onAction="#onToolElephant" styleClass="tool-radio" text="🔵 Thêm Voi" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbRock" onAction="#onToolRock" styleClass="tool-radio" text="⬛ Thêm Đá" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbTree" onAction="#onToolTree" styleClass="tool-radio" text="🟩 Gieo cây" toggleGroup="$toolGroup" />
    </VBox>

    <Separator />
    
    <Region VBox.vgrow="ALWAYS" />
</VBox>
