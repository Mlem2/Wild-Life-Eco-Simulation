<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" styleClass="control-panel" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.graphic.ui.controller.ControlPanel">

    <Label styleClass="panel-section-title" text="🎮 Điều Khiển" />

    <VBox spacing="8" styleClass="panel-section">
        <Button fx:id="btnPause" maxWidth="Infinity" onAction="#onPauseClicked" styleClass="btn-primary" text="⏸ Pause" />
        <Button maxWidth="Infinity" onAction="#onResetZoomClicked" styleClass="btn-secondary" text="🔍 Reset Zoom" />
    </VBox>

    <Separator />

    <Label styleClass="panel-section-title" text="⚡ Tốc Độ" />
    <VBox spacing="6" styleClass="panel-section">
        <Label fx:id="labelSpeed" styleClass="value-label" text="Tối đa" />
        <Slider fx:id="sliderSpeed" />
    </VBox>

    <Separator />

    <Label styleClass="panel-section-title" text="🛠 Công Cụ" />
    <VBox spacing="5" styleClass="panel-section">
        <fx:define>
            <ToggleGroup fx:id="toolGroup" />
        </fx:define>

        <RadioButton fx:id="rbNone" onAction="#onToolNone" selected="true" styleClass="tool-radio" text="🚫 Không chọn">
         <toggleGroup>
            <ToggleGroup fx:id="toolGroup" />
         </toggleGroup></RadioButton>
        <RadioButton fx:id="rbGrass" onAction="#onToolGrass" styleClass="tool-radio" text="🟩 Gieo cỏ" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbRabbit" onAction="#onToolRabbit" onMouseClicked="#onMapClicked" styleClass="tool-radio" text="⚪ Thêm Thỏ" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbDeer" onAction="#onToolDeer" styleClass="tool-radio" text="🟤 Thêm Hươu" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbWolf" onAction="#onToolWolf" styleClass="tool-radio" text="🔘 Thêm Sói" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbTiger" onAction="#onToolTiger" styleClass="tool-radio" text="🟠 Thêm Hổ" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbElephant" onAction="#onToolElephant" styleClass="tool-radio" text="🔵 Thêm Voi" toggleGroup="$toolGroup" />
        <RadioButton fx:id="rbRock" onAction="#onToolRock" styleClass="tool-radio" text="⬛ Đặt Đá" toggleGroup="$toolGroup" />
    </VBox>

    <Separator />

    <Label styleClass="panel-section-title" text="🗺 Chú Thích" />
    <VBox spacing="4" styleClass="panel-section legend-box">
        <Label styleClass="legend-item" text="⚪ Thỏ       🟤 Hươu" />
        <Label styleClass="legend-item" text="🔘 Sói       🟠 Hổ" />
        <Label styleClass="legend-item" text="🔵 Voi       🩵 Người" />
        <Label styleClass="legend-item" text="🟡 Vịt       🩵 Cá" />
        <Label styleClass="legend-item" text="🟩 Cỏ        🟢 Cây" />
        <Label styleClass="legend-item" text="⬛ Đá" />
        <Separator />
        <Label styleClass="legend-hint" text="Chấm giữa = Trạng thái:" />
        <Label styleClass="legend-item" text="🟡 Chạy  🟢 Ăn  🔴 Săn" />
        <Label styleClass="legend-item" text="🟠 Trốn  🩵 Ngủ  💧 Uống" />
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

</VBox>
